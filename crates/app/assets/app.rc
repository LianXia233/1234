#include <windows.h>

1 ICON "assets/icon.ico"

/* RT_MANIFEST = 24，ID 1。声明依赖 comctl32 v6，否则加载器绑定 system32 的 v5
   版 comctl32，运行时会 “无法定位程序输入点 TaskDialogIndirect”。
   注意：构建时本 .rc 编译出的 app_res.o 不链入 exe（避免与 mingw 强制链入的
   default-manifest.o 的两个 .rsrc 节冲突导致 corrupt），改由
   tools/embed_manifest.py 在链接后把这份完整资源整体注入。 */
1 24 "assets/app.manifest"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "AcgDev"
            VALUE "FileDescription",  "AcgDev HTTP Downloader"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "acgdev"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "AcgDev.exe"
            VALUE "ProductName",      "AcgDev HTTP Downloader"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
