#include <windows.h>

1 ICON "assets/icon.ico"

/* RT_MANIFEST = 24，ID 1。声明依赖 comctl32 v6，否则加载器绑定 system32 的 v5
   版 comctl32，运行时会 “无法定位程序输入点 TaskDialogIndirect”。
   注意：本文件是构建输入之一（build.rs 只监听变更，编译由 build-win64.sh 完成）。
   两个易踩的坑：
   1) publicKeyToken 必须是 6595b64144ccf1df（WinSxS 实测值）。写成 6595b64144ccf175
      会被报“找不到从属程序集 Microsoft.Windows.Common-Controls”。
   2) manifest 保持 UTF-8 嵌入。改成无 BOM 的 UTF-16LE 会因 XML 声明写着 UTF-8
      而被解析器按 UTF-8 读取，报“无效的 Xml 语法”。 */
1 24 "assets/app.manifest"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "AcgDev"
            VALUE "FileDescription",  "AcgDev HTTP Downloader"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "acgdev"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "AcgDev.exe"
            VALUE "ProductName",      "AcgDev HTTP Downloader"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
